:root {
    --primary-color: #000000;
    --secondary-color: #666666;
    --accent-color: #333333;
    --bg-color: #ffffff;
    --bg-secondary: #f8f8f8;
    --text-primary: #1a1a1a;
    --text-secondary: #666666;
    --border-color: #e5e5e5;
    --hover-color: #000000;
    --transition: all 0.3s ease;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    line-height: 1.6;
    color: var(--text-primary);
    background-color: var(--bg-color);
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
}

/* Navigation */
.navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background-color: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border-color);
    z-index: 1000;
    transition: var(--transition);
}

.nav-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 0;
}

.logo {
    font-size: 24px;
    font-weight: 700;
    color: var(--primary-color);
    text-decoration: none;
    letter-spacing: -0.5px;
}

.nav-links {
    display: flex;
    list-style: none;
    gap: 32px;
}

.nav-links a {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 400;
    font-size: 15px;
    transition: var(--transition);
    position: relative;
}

.nav-links a:hover {
    color: var(--primary-color);
}

.nav-links a::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 1px;
    background-color: var(--primary-color);
    transition: width 0.3s ease;
}

.nav-links a:hover::after {
    width: 100%;
}

/* Hero Section */
.hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 80px;
    padding-bottom: 80px;
}

.hero-content {
    max-width: 800px;
}

.hero-title {
    font-size: clamp(40px, 8vw, 72px);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 24px;
    letter-spacing: -2px;
}

.greeting {
    display: block;
    font-size: clamp(20px, 4vw, 28px);
    font-weight: 400;
    color: var(--text-secondary);
    margin-bottom: 12px;
    letter-spacing: 0;
}

.name {
    display: block;
    color: var(--primary-color);
}

.hero-subtitle {
    font-size: clamp(18px, 3vw, 22px);
    color: var(--text-secondary);
    margin-bottom: 40px;
    line-height: 1.6;
    font-weight: 400;
}

.hero-cta {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
}

.btn {
    padding: 14px 32px;
    text-decoration: none;
    font-size: 16px;
    font-weight: 500;
    border-radius: 4px;
    transition: var(--transition);
    display: inline-block;
    border: 1px solid transparent;
}

.btn-primary {
    background-color: var(--primary-color);
    color: var(--bg-color);
}

.btn-primary:hover {
    background-color: var(--accent-color);
    transform: translateY(-2px);
}

.btn-secondary {
    background-color: transparent;
    color: var(--primary-color);
    border-color: var(--primary-color);
}

.btn-secondary:hover {
    background-color: var(--primary-color);
    color: var(--bg-color);
}

/* Section Styles */
section {
    padding: 100px 0;
}

.section-title {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 700;
    margin-bottom: 60px;
    letter-spacing: -1px;
    color: var(--primary-color);
}

/* About Section */
.about {
    background-color: var(--bg-secondary);
}

.about-text {
    font-size: 18px;
    line-height: 1.8;
    color: var(--text-secondary);
    margin-bottom: 48px;
    max-width: 800px;
}

.skills-title {
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 24px;
    color: var(--primary-color);
}

.skills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
}

.skill-tag {
    padding: 8px 16px;
    background-color: var(--bg-color);
    border: 1px solid var(--border-color);
    border-radius: 4px;
    font-size: 14px;
    color: var(--text-primary);
    transition: var(--transition);
}

.skill-tag:hover {
    border-color: var(--primary-color);
    background-color: var(--primary-color);
    color: var(--bg-color);
}

/* Projects Section */
.projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 32px;
}

.project-card {
    background-color: var(--bg-color);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 32px;
    transition: var(--transition);
    display: flex;
    flex-direction: column;
}

.project-card:hover {
    border-color: var(--primary-color);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
}

.project-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 16px;
    gap: 16px;
}

.project-title {
    font-size: 24px;
    font-weight: 600;
    color: var(--primary-color);
    margin-bottom: 8px;
}

.project-date {
    font-size: 14px;
    color: var(--text-secondary);
    white-space: nowrap;
}

.project-description {
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 20px;
    flex-grow: 1;
}

.project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
}

.project-tech span {
    font-size: 12px;
    padding: 4px 12px;
    background-color: var(--bg-secondary);
    border-radius: 4px;
    color: var(--text-primary);
    font-weight: 500;
}

.project-link {
    color: var(--primary-color);
    text-decoration: none;
    font-weight: 500;
    font-size: 15px;
    transition: var(--transition);
    align-self: flex-start;
}

.project-link:hover {
    color: var(--text-secondary);
}

/* Experience Section */
.experience {
    background-color: var(--bg-secondary);
}

.experience-list {
    display: flex;
    flex-direction: column;
    gap: 48px;
}

.experience-item {
    background-color: var(--bg-color);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 32px;
    transition: var(--transition);
}

.experience-item:hover {
    border-color: var(--primary-color);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
}

.experience-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 20px;
    gap: 24px;
    flex-wrap: wrap;
}

.experience-title {
    font-size: 22px;
    font-weight: 600;
    color: var(--primary-color);
    margin-bottom: 4px;
}

.experience-company {
    font-size: 16px;
    color: var(--text-secondary);
}

.experience-date {
    font-size: 14px;
    color: var(--text-secondary);
    white-space: nowrap;
}

.experience-description {
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 12px;
}

.experience-description:last-child {
    margin-bottom: 0;
}

/* Contact Section */
.contact-content {
    max-width: 600px;
}

.contact-text {
    font-size: 18px;
    color: var(--text-secondary);
    margin-bottom: 40px;
    line-height: 1.7;
}

.contact-info {
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.contact-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-decoration: none;
    color: inherit;
    transition: var(--transition);
    padding: 16px;
    border: 1px solid var(--border-color);
    border-radius: 8px;
}

.contact-item:hover {
    border-color: var(--primary-color);
    background-color: var(--bg-secondary);
}

.contact-label {
    font-size: 14px;
    color: var(--text-secondary);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.contact-value {
    font-size: 18px;
    color: var(--primary-color);
    font-weight: 500;
}

/* Footer */
.footer {
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
    padding: 32px 0;
    text-align: center;
}

.footer p {
    color: var(--text-secondary);
    font-size: 14px;
}

/* Responsive Design */
@media (max-width: 768px) {
    .nav-links {
        gap: 20px;
    }

    .nav-links a {
        font-size: 14px;
    }

    .hero {
        padding-top: 100px;
    }

    section {
        padding: 60px 0;
    }

    .section-title {
        margin-bottom: 40px;
    }

    .projects-grid {
        grid-template-columns: 1fr;
    }

    .experience-header {
        flex-direction: column;
    }

    .hero-cta {
        flex-direction: column;
    }

    .btn {
        width: 100%;
        text-align: center;
    }
}

@media (max-width: 480px) {
    .container {
        padding: 0 16px;
    }

    .project-card,
    .experience-item {
        padding: 24px;
    }

    .nav-content {
        padding: 16px 0;
    }
}

